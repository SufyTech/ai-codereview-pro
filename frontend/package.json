{
  "name": "codereview-pro-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend for CodeReview Pro: a multi-agent pull request reviewer with human escalation (React, TypeScript, Vite).",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "code-review",
    "multi-agent",
    "langgraph",
    "groq",
    "react",
    "typescript"
  ],
  "author": "Sufiyan Khan",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
